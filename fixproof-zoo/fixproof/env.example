# Paste into Fixproof's environment. Replace <...> values.
GCP_PROJECT_ID=fixproof-zoo-sandbox
GCP_PUBSUB_AUDIENCE=<FIXPROOF_API_URL>/webhooks/gcp
GCP_PUBSUB_SERVICE_ACCOUNT=zoo-pubsub-push@fixproof-zoo-sandbox.iam.gserviceaccount.com
GCP_READ_CREDENTIALS_FILE=<path to .keys/fixproof-reader.json>
GCP_ACTION_CREDENTIALS_FILE=<path to .keys/fixproof-actor.json>   # must differ from the reader
CACHE_INVALIDATE_URL=<zoo-shop URL>/cache/invalidate
CACHE_INVALIDATE_TOKEN=<same value as the zoo's CACHE_INVALIDATE_TOKEN secret>
GITHUB_TOKEN=<fine-grained token for the fixproof-zoo repo only: Contents + Pull requests write; Checks, Statuses, Actions read>
VERIFY_DELAY_SECONDS=300
